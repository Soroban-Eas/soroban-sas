        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "Transaction Batch Size Distribution",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(sas_batch_size_distribution_bucket[5m])) by (le))",
          "legendFormat": "p50 Batch Size",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum(rate(sas_batch_size_distribution_bucket[5m])) by (le))",
          "legendFormat": "p90 Batch Size",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(sas_batch_size_distribution_bucket[5m])) by (le))",
          "legendFormat": "p99 Batch Size",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(sas_batch_size_distribution_sum[5m]) / rate(sas_batch_size_distribution_count[5m])",
          "legendFormat": "Average Batch Size",
          "range": true,
          "refId": "D"
        }
      ]
