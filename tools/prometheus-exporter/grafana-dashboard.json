      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (error_code) (rate(sas_contract_reverts_total[5m]))",
          "legendFormat": "Error Code: {{error_code}}",
          "range": true,
          "refId": "A"
        }
      ]
