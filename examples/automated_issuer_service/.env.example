# Copy to .env; NEVER commit real keys or secrets.
# Assumes the standalone local Stellar quickstart RPC is running.
RPC_URL=http://stellar:8000/soroban/rpc
NETWORK_PASSPHRASE=Standalone Network ; February 2017
SAS_CONTRACT_ID=
SCHEMA_UID=
# Must differ from every attester G... account.
RECIPIENT=
# Comma-separated HEX-ENCODED ED25519 32-BYTE SECRET SEEDS, not S... strkeys.
# Fund *each* account; register each as an authorized schema delegate.
CHANNEL_SEEDS_HEX=
JOBS=24
MODE=compare
MIN_CHANNEL_BALANCE_STROOPS=1000000
