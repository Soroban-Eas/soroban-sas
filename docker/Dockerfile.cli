# BuildKit compiles natively under QEMU for the requested TARGETPLATFORM.
FROM rust:1.83-alpine AS builder
RUN apk add --no-cache musl-dev build-base
WORKDIR /app
COPY . .
RUN cargo build --locked --release -p soroban-sas-cli --target $(rustc -vV | sed -n 's/^host: //p') && \
    install -Dm755 target/$(rustc -vV | sed -n 's/^host: //p')/release/soroban-sas-cli /output/soroban-sas-cli

FROM scratch
COPY --from=builder /output/soroban-sas-cli /usr/local/bin/soroban-sas-cli
ENTRYPOINT ["/usr/local/bin/soroban-sas-cli"]
