{
  "name": "@soroban-sas/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Soroban Solidity Attestation Service (SAS): schema registration, attestation issuance/revocation, delegated attestations, and byte-identical hashing with the Rust contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
