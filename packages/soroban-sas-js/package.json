{
  "name": "@soroban-sas/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Soroban Solidity Attestation Service (SAS): schema registration, attestation issuance/revocation, delegated attestations, and byte-identical hashing with the Rust contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./typegen": {
      "types": "./dist/typegen.d.ts",
      "import": "./dist/typegen.js",
      "require": "./dist/typegen.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json && node scripts/prepare-declarations.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "browser:check": "node scripts/browser-compatibility.mjs",
    "test:testnet": "node scripts/testnet-wallet-smoke.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@stellar/stellar-sdk": "^13.1.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "bin": {
    "sas-typegen": "dist/cli.js"
  }
}
